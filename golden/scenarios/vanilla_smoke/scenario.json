{
  "schemaVersion": 2,
  "id": "vanilla_smoke",
  "targets": [
    "fabric-1.20.1", "fabric-1.21.1", "fabric-1.21.4", "fabric-1.21.8", "fabric-1.21.11",
    "neoforge-1.21.1", "neoforge-1.21.4", "neoforge-1.21.8"
  ],
  "settleTicks": 40,
  "selection": {
    "min": [0, 60, 0],
    "max": [15, 72, 15]
  },
  "export": {
    "threadCount": 1,
    "atlasMode": "individual",
    "coordinateMode": "centered",
    "exportDoubleSided": true,
    "nonsolidCulling": true
  },
  "variants": [
    {"id": "default"}
  ],
  "requiredProbes": ["export-start", "export-complete"],
  "forbiddenProbes": ["resource-fallback-failed"],
  "cameras": [
    {"id": "overview", "azimuth": 45, "elevation": 32, "margin": 1.2}
  ],
  "performanceBudget": {"timeoutSeconds": 300, "warningRegressionPercent": 20},
  "features": [
    "opaque_block",
    "non_cube_block",
    "cutout_block",
    "translucent_block",
    "biome_tint",
    "fluid",
    "block_entity",
    "entity"
  ],
  "assertions": [
    {
      "id": "entity_geometry",
      "type": "material",
      "materialRegex": "^entity:",
      "minMaterials": 1,
      "minPrimitives": 1,
      "minTriangles": 1
    },
    {
      "id": "block_entity_geometry",
      "type": "material",
      "materialRegex": "^blockentity:",
      "minMaterials": 1,
      "minPrimitives": 1,
      "minTriangles": 1
    }
  ]
}
