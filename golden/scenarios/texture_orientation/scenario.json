{
  "schemaVersion": 2,
  "id": "texture_orientation",
  "settleTicks": 40,
  "selection": {"min": [0, 60, 0], "max": [15, 70, 10]},
  "export": {"threadCount": 1, "atlasMode": "individual", "coordinateMode": "centered", "exportDoubleSided": true, "nonsolidCulling": true},
  "variants": [
    {"id": "individual"},
    {"id": "atlas", "export": {"threadCount": 16, "atlasMode": "atlas"}}
  ],
  "requiredProbes": ["export-start", "export-complete"],
  "cameras": [
    {"id": "overview", "azimuth": 35, "elevation": 30, "margin": 1.15},
    {"id": "front", "azimuth": 0, "elevation": 8, "margin": 1.1}
  ],
  "performanceBudget": {"timeoutSeconds": 300, "warningRegressionPercent": 20},
  "features": ["asymmetric_texture", "rotated_model", "uv_lock", "atlas_appearance_equivalence"],
  "assertions": [
    {"id": "directional_faces_present", "type": "material", "materialRegex": "minecraft:block/(observer|furnace|pumpkin|crafting_table)", "minMaterials": 3, "minTriangles": 6},
    {"id": "glazed_rotation_present", "type": "material", "materialRegex": "glazed_terracotta", "minMaterials": 1, "minTriangles": 2}
  ]
}
