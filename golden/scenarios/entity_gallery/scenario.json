{
  "schemaVersion": 2,
  "id": "entity_gallery",
  "settleTicks": 50,
  "selection": {"min": [0, 60, 0], "max": [20, 72, 12]},
  "export": {"threadCount": 1, "atlasMode": "individual", "coordinateMode": "centered", "exportDoubleSided": true, "nonsolidCulling": true},
  "variants": [{"id": "default"}],
  "requiredProbes": ["export-start", "export-complete"],
  "cameras": [{"id": "overview", "azimuth": 25, "elevation": 20, "margin": 1.2}],
  "performanceBudget": {"timeoutSeconds": 300, "warningRegressionPercent": 20},
  "features": ["armor_stand", "minecart", "item_frame", "painting"],
  "assertions": [
    {"id": "entity_geometry", "type": "material", "materialRegex": "^entity:", "minMaterials": 1, "minPrimitives": 2, "minTriangles": 2, "minUvVertices": 1}
  ]
}
