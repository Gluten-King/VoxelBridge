{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "icon": "icon.png",
  "description": "${mod_description}",
  "contact": {
    "homepage": "https://modrinth.com/mod/voxelbridge",
    "issues": "https://github.com/Gluten-King/VoxelBridge/issues"
  },
  "authors": [
  "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.voxelbridge.fabric.VoxelBridgeFabric"
    ]
  },
  "mixins": [
    "voxelbridge.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}"
  }
}
